# PSG PEMS Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=33317
DB_NAME=psg_workspace
DB_USER=psg_app
DB_PASSWORD=your_password_here

# Session
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# Puppeteer (for PDF generation)
# Set to 'true' if running in a headless server environment
PUPPETEER_NO_SANDBOX=false
